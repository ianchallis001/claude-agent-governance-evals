# Copy this file to `.env` and fill in your own key. `.env` is git-ignored;
# this template (`.env.example`) is the only env file that is committed.
#
#   cp .env.example .env
#   # edit .env, paste your key
#   set -a && . ./.env && set +a      # load it into the shell (bash)
#   cage eval --max-cost-usd 0.50     # the cap is enforced since #81/#89
#
# Never commit the real .env, and never paste a live key into chat, an issue,
# or a commit. Rotate any key that leaks.

# Your Anthropic API key (console.anthropic.com -> API Keys). Only the live-API
# path uses it; the default offline suite needs no key.
ANTHROPIC_API_KEY=
